<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+（API 31）的系统启动页。

  系统会接管启动画面，因此这里显式指定：
    * 背景：白色；
    * 中央图标：新的原创图标（前景层，1024px 内自适应遮罩）；
    * 底部品牌图：PetLife + 一条粉色加载线。

  不做长时间动画（animationDuration = 200ms），Flutter 首帧到来后平滑淡入首页。
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
