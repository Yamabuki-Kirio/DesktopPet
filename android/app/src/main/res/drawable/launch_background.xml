<?xml version="1.0" encoding="utf-8"?>
<!--
  启动页（API < 31 的传统 windowBackground 路径）。

  构图：白色背景 + 中央新图标 + 下方 PetLife + 一条粉色加载线。
  位图由 tools/make_app_icon.py 生成，可直接复现。
  不做长时间不可跳过的动画：Flutter 画出第一帧后系统就会移除本背景。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_petlife" />
    </item>
</layer-list>
