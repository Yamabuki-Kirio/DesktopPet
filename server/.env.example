# PetLife 服务端环境变量模板
#
# 用法：
#   cp .env.example .env      然后修改 JWT 密钥与数据库口令
#
# ⚠️ 绝对不要把真实的 .env 提交到代码库（.gitignore 已排除）。

# --- 基础 ---
PETLIFE_APP_NAME=PetLife API
# development / production。production 会关闭 /docs 与 /openapi.json
PETLIFE_ENVIRONMENT=development

# --- 数据库 ---
# 本地开发可直接用 SQLite（无需 PostgreSQL）：
PETLIFE_DATABASE_URL=sqlite+pysqlite:///./petlife_server_dev.db
# 生产（Docker Compose 会自动覆盖成这个形式）：
# PETLIFE_DATABASE_URL=postgresql+psycopg2://petlife:CHANGE_ME@db:5432/petlife
PETLIFE_DATABASE_ECHO=false

# --- JWT ---
# 必须替换！生成方式：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# 注意：配置项会拒绝 change-me / secret 这类占位值，防止误部署。
PETLIFE_JWT_SECRET=replace-with-a-real-random-secret
PETLIFE_JWT_ALGORITHM=HS256
PETLIFE_ACCESS_TOKEN_TTL_MINUTES=15
PETLIFE_REFRESH_TOKEN_TTL_DAYS=30
PETLIFE_JWT_ISSUER=petlife

# --- Argon2id 参数（按机器性能调整；默认值接近 OWASP 推荐档位）---
PETLIFE_ARGON2_TIME_COST=3
PETLIFE_ARGON2_MEMORY_COST=65536
PETLIFE_ARGON2_PARALLELISM=4

# --- 同步 ---
PETLIFE_SYNC_MAX_BATCH_SIZE=200
PETLIFE_SYNC_PULL_MAX_ITEMS=500

# --- Phase 3：集成（Telegram 绑定流程 / MCP）---
# 集成服务令牌：**仅**用于 Telegram 绑定流程（/api/v1/integrations/telegram/**）。
# 注意它已经不是 MCP 读数据所需的凭据（那是个人访问密钥，见下）。
#   * 不复用任何用户密码；
#   * 留空 = 这些绑定接口全部拒绝（不会"无鉴权放行"）；
#   * 生成方式同上：python -c "import secrets;print(secrets.token_urlsafe(48))"
PETLIFE_INTEGRATION_TOKEN=
# 一次性绑定码有效期（分钟）
PETLIFE_LINK_CODE_TTL_MINUTES=10
# 集成接口单次返回条数上限
PETLIFE_INTEGRATION_MAX_ITEMS=50

# --- Phase 3：MCP Server 专用（仅 MCP 进程读取）---
# PetLife API 地址（MCP 只通过它读数据，**不**需要数据库配置）
PETLIFE_MCP_URL=http://127.0.0.1:8000
# 个人访问密钥（plk_...）：在 Windows 客户端「账户与同步 → AI 数据访问」生成，
# 只显示一次。它是 MCP 的**唯一**身份凭据：服务端按密钥确定账户。
#   * 留空 = 所有工具调用都会被 401 拒绝；
#   * 撤销后立即失效（客户端里可随时撤销）。
PETLIFE_API_KEY=
# 单次 API 调用超时（秒）
PETLIFE_REQUEST_TIMEOUT=15
# MCP Streamable HTTP 监听地址
PETLIFE_MCP_HOST=127.0.0.1
PETLIFE_MCP_PORT=8765
# 是否让 httpx 读取 HTTP_PROXY/ALL_PROXY 等代理环境变量。
# 默认 false：服务进程访问自家 API 应当是确定行为（开着系统代理时
# 默认值会让请求绕进代理，表现为莫名其妙的 502）。
PETLIFE_MCP_TRUST_ENV=false
# 通过反向代理/域名暴露 MCP 时，把 Host/Origin 加进白名单（逗号分隔）。
# 留空 = 沿用 SDK 默认（仅允许 127.0.0.1 / localhost / [::1]）。
PETLIFE_MCP_ALLOWED_HOSTS=
PETLIFE_MCP_ALLOWED_ORIGINS=

# --- Docker Compose 用的 PostgreSQL 初始化变量（仅 compose 读取）---
POSTGRES_DB=petlife
POSTGRES_USER=petlife
# 必须设置一个强口令；compose 在未设置时会直接报错退出，
# 避免"默认弱密码"把库暴露出去。
POSTGRES_PASSWORD=
# 只监听本机，避免无意中把服务暴露到局域网/公网
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8000
